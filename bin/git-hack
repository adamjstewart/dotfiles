#!/bin/sh

set -eu

# https://docs.python.org/3/library/functions.html#eval
# https://docs.python.org/3/library/functions.html#exec
# https://docs.python.org/3/library/marshal.html#module-marshal
# https://docs.python.org/3/library/os.html#process-management
# https://docs.python.org/3/library/pickle.html
# https://docs.python.org/3/library/shelve.html#module-shelve
# https://docs.python.org/3/library/subprocess.html#security-considerations
# https://numpy.org/doc/stable/reference/generated/numpy.load.html
# https://docs.pytorch.org/docs/stable/notes/serialization.html#weights-only-security
# https://docs.pytorch.org/docs/stable/hub.html
# https://docs.pytorch.org/vision/stable/models.html
git grep -P '\beval\([^)]|\bexec\([^)]|marshal\.load|os\.exec|os\.fork|os\.popen|os\.posix_spawn|os\.spawn|os\.system|pickle\.load|shelve\.open|shell=True|allow_pickle=True|weights_only=False|torch\.load(?!.*weights_only=True)|load_state_dict_from_url\((?!.*weights_only=True)|get_state_dict\((?!.*weights_only=True)'
